  "license": "MIT",
  "author": {
    "name": "yanwei999999",
    "email": "yanwei999999@163.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanwei999999/dsh-guard.git"
  },
  "homepage": "https://github.com/yanwei999999/dsh-guard",
  "bugs": {
    "url": "https://github.com/yanwei999999/dsh-guard/issues"
  },
  "bin": {
    "dsh-guard": "./dsh-guard.mjs"
  },
  "files": [
    "dsh-guard.mjs",
    "dsh-guard.cmd",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "deepseek",
    "plugin",
    "watchdog",
    "rollback",
    "cli"
  ],
  "dependencies": {
